<resources>
    <!-- Compose supplies Material 3; the activity needs only a lightweight platform shell. -->
    <style name="Theme.MinimalLauncher" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        
        <!-- OLauncher navigation and wallpaper styling -->
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorEdgeEffect">@android:color/transparent</item>
    </style>
</resources>
